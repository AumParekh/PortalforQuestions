  {
    "id": "SC-bank-LRq01-01",
    "mode": "direction",
    "area": "LTR",
    "reading": "LTR-1: Liquidity Risk",
    "reading_id": "LTR-1",
    "source": {
      "kind": "bank",
      "questionId": "LR-QB-0001"
    },
    "trap_category": "Sign",
    "setup": "One-year lognormal VaR on a \\$1.0m position: $VaR = V\\,[1 - e^{\\mu - z\\sigma}]$. Expected return $\\mu = 14\\%$, volatility $\\sigma = 26\\%$, one-tail $z = 1.645$ (95%).",
    "ask": "Compared with the same VaR when the expected return is set to zero, the VaR with the 14% drift is:",
    "options": [
      {
        "label": "Smaller",
        "correct": true
      },
      {
        "label": "Larger",
        "correct": false,
        "why": "Treated the positive drift as extra risk. In $e^{\\mu - z\\sigma}$ a positive $\\mu$ lifts the worst-case value, so the loss shrinks."
      },
      {
        "label": "The same",
        "correct": false,
        "why": "Assumed the drift cancels out over one year. It sits inside the exponent and moves the 5% worst-case value up by 14 points of log return."
      }
    ],
    "working": [
      {
        "label": "With drift",
        "display": "$1 - e^{0.14 - 0.4277} = 1 - e^{-0.2877} = 0.250$, so VaR $\\approx \\$250{,}000$",
        "value": 250013
      },
      {
        "label": "Zero drift",
        "display": "$1 - e^{-0.4277} = 0.348$, so VaR $\\approx \\$348{,}000$",
        "value": 347993
      }
    ],
    "takeaway": "In lognormal VaR a positive expected return lowers the loss quantile; ignore it only when the horizon is short.",
    "check": {
      "inputs": {
        "V": 1000000,
        "mu": 0.14,
        "z": 1.645,
        "sig": 0.26
      },
      "steps": [
        {
          "name": "var_drift",
          "expr": "V*(1-exp(mu-z*sig))",
          "value": 250013.0
        },
        {
          "name": "var_zero",
          "expr": "V*(1-exp(-z*sig))",
          "value": 347993.0
        },
        {
          "name": "gap",
          "expr": "var_zero-var_drift",
          "value": 97979.6
        }
      ]
    }
  },
  {
    "id": "SC-bank-LRq01-02",
    "mode": "magnitude",
    "area": "LTR",
    "reading": "LTR-1: Liquidity Risk",
    "reading_id": "LTR-1",
    "source": {
      "kind": "bank",
      "questionId": "LR-QB-0004"
    },
    "trap_category": "Formula",
    "setup": "A stock trades at a midpoint of INR 200 with an average bid-ask spread of INR 0.80, held constant. Position: 10,000 shares. Daily return volatility is 2% and returns are normal with zero mean. Use $z = 2.33$ (99%).",
    "ask": "The one-day 99% liquidity-adjusted VaR (VaR plus half-spread cost) is closest to:",
    "options": [
      {
        "label": "INR 4,000",
        "correct": false,
        "why": "Kept only the half-spread cost ($\\tfrac12 \\times 0.004 \\times 2{,}000{,}000$) and left the market VaR out."
      },
      {
        "label": "INR 97,000",
        "correct": true
      },
      {
        "label": "INR 940,000",
        "correct": false,
        "why": "Read the 2% daily volatility as 20% when computing the market VaR, then added the spread cost."
      },
      {
        "label": "INR 9,300,000",
        "correct": false,
        "why": "Entered the volatility as 2 instead of 0.02 (percent as a whole number) in $V \\times z \\times \\sigma$."
      }
    ],
    "working": [
      {
        "label": "Position value",
        "display": "$10{,}000 \\times 200 = 2{,}000{,}000$",
        "value": 2000000
      },
      {
        "label": "Market VaR",
        "display": "$2{,}000{,}000 \\times 2.33 \\times 0.02 = 93{,}200$",
        "value": 93200
      },
      {
        "label": "Spread cost",
        "display": "$\\tfrac12 \\times \\tfrac{0.80}{200} \\times 2{,}000{,}000 = 4{,}000$",
        "value": 4000
      },
      {
        "label": "LVaR",
        "display": "$93{,}200 + 4{,}000 = 97{,}200$",
        "value": 97200
      }
    ],
    "takeaway": "Market VaR dominates a liquid-ish name: the half-spread cost is small, but it is added on top, not instead.",
    "check": {
      "inputs": {
        "n": 10000,
        "P": 200,
        "spr": 0.8,
        "sig": 0.02,
        "z": 2.33
      },
      "steps": [
        {
          "name": "V",
          "expr": "n*P",
          "value": 2000000.0
        },
        {
          "name": "var",
          "expr": "V*z*sig",
          "value": 93200.0
        },
        {
          "name": "cost",
          "expr": "0.5*(spr/P)*V",
          "value": 4000.0
        },
        {
          "name": "LVaR",
          "expr": "var+cost",
          "value": 97200.0
        },
        {
          "name": "slip_cost_only",
          "expr": "cost",
          "value": 4000.0
        },
        {
          "name": "slip_vol20",
          "expr": "V*z*0.2+cost",
          "value": 936000.0
        },
        {
          "name": "slip_vol_whole",
          "expr": "V*z*2+cost",
          "value": 9324000.0
        }
      ]
    }
  },
