        "why": "Read $\\sigma_s = 0.00019$ as 0.19% ($0.0019$), ten times too large."
      },
      {
        "label": "About \\$2.00",
        "correct": false,
        "why": "Added a second full expected cost instead of the small risk term, doubling it to \\$4.00."
      }
    ],
    "working": [
      {
        "label": "Midprice",
        "display": "$(335 + 331)/2 = 333$",
        "value": 333
